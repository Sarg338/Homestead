<?xml version="1.0" encoding="utf-8"?>
<!--
  No flagRequestFilterKeyEvents: Fire OS does not deliver KEYCODE_HOME to key filtering, and
  the flag would route every key event on the device through this process.
  No packageNames filter: the service must see non-Amazon apps come to the foreground so it
  can remove the overlay.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRetrieveWindowContent="false"
    android:description="@string/service_desc"/>
